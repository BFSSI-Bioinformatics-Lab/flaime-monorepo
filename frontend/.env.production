REACT_APP_VERSION = "PROD"

# Same-origin: API is served by the same Django app under the same prefix,
# so no host is needed here.
REACT_APP_API_URL = ""
REACT_APP_IMG_SERVER_URL = "https://flaime.scdc-bio.ca/images"

REACT_APP_TITLE = "FLAIME"

# CRA build-time path prefix. Must match Django's DJANGO_URL_PREFIX
# (see .env.fsdh) so router links, asset paths, and API calls all agree
# with FORCE_SCRIPT_NAME on the backend.
PUBLIC_URL = "/app/flaime"