# Non-secret, deployment-specific config for the FSDH image.
# Baked into the image at `docker build` time (see Dockerfile) and read by
# django-environ at container startup. Real secrets (DATABASE_URL,
# DJANGO_SECRET_KEY) are NOT here — they're injected at runtime via the
# `environment:` block in docker-compose.fsdh.yml, which takes precedence
# over anything in this file.
#
# This file is committed to git. Never put credentials in it.

DJANGO_READ_DOT_ENV_FILE=True
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_DEBUG=False

DJANGO_ALLOWED_HOSTS=fsdh-proj-flaime-webapp-prd.azurewebsites.net

DJANGO_URL_PREFIX=/app/flaime

DJANGO_CSRF_TRUSTED_ORIGINS=https://fsdh-proj-flaime-webapp-prd.azurewebsites.net

# FSDH terminates TLS in front of the app; set to False if the proxy does not
# forward X-Forwarded-Proto and this causes a redirect loop.
DJANGO_SECURE_SSL_REDIRECT=True
